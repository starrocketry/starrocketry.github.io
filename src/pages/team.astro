---

<Layout title="Our Team">
  <Navbar />
  <main class="team-container">
    <header class="team-header">
      <div class="badge">MISSION CONTROL</div>
      <h1>OUR TEAM</h1>
    </header>

    {
      teamSections.map(
        (section) =>
          section.members.length > 0 && (
            <section class="section-wrapper">
              <div class="section-header">
                <span class="badge">{section.sectionTitle}</span>
                <div class="section-divider" />
              </div>

              <div
                class={`team-grid ${
                  section.members.length === 1 ? "single-member" : ""
                }`}
              >
                {section.members.map((member) => (
                  <div class="member-card glass">
                    <div class="photo-wrapper">
                      <img src={member.photo} alt={member.name} />
                    </div>

                    <div class="info">
                      <h3>{member.name}</h3>
                      <p class="role">{member.role}</p>
                    </div>

                    <div class="divider" />

                    <div class="socials">
                      <a
                        href={member.github}
                        target="_blank"
                        class="social-link"
                      >
                        GITHUB
                      </a>
                      <a
                        href={member.linkedin}
                        target="_blank"
                        class="social-link"
                      >
                        LINKEDIN
                      </a>
                      <a
                        href={member.orcid}
                        target="_blank"
                        class="social-link"
                      >
                        ORCiD
                      </a>
                      <div class="email-tag">
                        <span class="label">EMAIL:</span>
                        <span class="id">
                          <a href={`mailto:${member.email}`}>{member.email}</a>
                        </span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ),
      )
    }
  </main>
  <Footer />
</Layout>
