---
import "../styles/marquee.css";

// 1. Updated asset paths to bypass adblock URL filters
const partnerData = [
  {
    name: "Rukmini Education Charitable Trust",
    logo: "./brand-logo/logo.png",
    website: "https://reva.edu.in/",
    tier: "static_fire",
  },
  {
    name: "IDEA Lab",
    logo: "./brand-logo/idea-lab.png",
    website: "https://www.reva.edu.in/aicte-idea-lab",
    tier: "staging",
  },
  {
    name: "Ansys by Synopsys",
    logo: "./brand-logo/ansys-logo.svg",
    website: "https://www.ansys.com/",
    tier: "staging",
  },
];

const TIER_MAP: Record<string, { label: string; color: string }> = {
  escape_velocity: { label: "ESCAPE VELOCITY", color: "#c594f0" },
  apogee: { label: "APOGEE", color: "#888888" },
  max_q: { label: "MAX-Q", color: "#888888" },
  static_fire: { label: "STATIC FIRE", color: "#888888" },
  staging: { label: "STAGING", color: "#888888" },
};

// Repeat array 3x for continuous loop
const marqueeArray = [...partnerData, ...partnerData, ...partnerData];
---

<div class="brand-flow-wrapper">
  {
    partnerData.length > 0 && (
      <div class="brand-flow-container">
        <div class="brand-flow-track infinite-scroll">
          {marqueeArray.map((p) => (
            <a
              href={p.website}
              target="_blank"
              rel="noopener noreferrer"
              class="partner-item-link"
            >
              <div
                class={`partner-card glass ${p.tier === "escape_velocity" ? "rank-escape" : ""}`}
              >
                <div class="partner-brand">
                  <img
                    src={import.meta.env.BASE_URL + p.logo.replace(/^\.\//, "")}
                    alt={p.name}
                    class="partner-mark"
                    loading="eager"
                  />
                  <div class="partner-meta">
                    <span
                      class="rank-label"
                      style={`color: ${TIER_MAP[p.tier]?.color || "#888888"}`}
                    >
                      {TIER_MAP[p.tier]?.label || "PARTNER"}
                    </span>
                    <span class="partner-name">{p.name}</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )
  }
</div>
