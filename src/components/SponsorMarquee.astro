---
import "../styles/marquee.css";

const sponsorData = [
  {
    name: "REVA University",
    logo: "./sponsor-logo/logo.png",
    website: "https://reva.edu.in/",
    tier: "static_fire",
  },
  {
    name: "AICTE IDEA Lab",
    logo: "./sponsor-logo/idea-lab.png",
    website: "https://www.reva.edu.in/aicte-idea-lab",
    tier: "staging",
  },
  {
    name: "Ansys by Synopsys",
    logo: "./sponsor-logo/ansys-logo.svg",
    website: "https://www.ansys.com/",
    tier: "staging",
  },
];

const TIER_MAP: Record<string, { label: string; color: string }> = {
  escape_velocity: { label: "ESCAPE VELOCITY", color: "#c594f0" },
  apogee: { label: "APOGEE", color: "#888888" },
  max_q: { label: "MAX-Q", color: "#888888" },
  static_fire: { label: "STATIC FIRE", color: "#888888" },
  staging: { label: "STAGING", color: "#888888" },
};

// Repeat array 3x for wide monitors
const marqueeArray = [...sponsorData, ...sponsorData, ...sponsorData];
---

<div class="marquee-wrapper">
  {
    sponsorData.length > 0 && (
      <div class="marquee-container">
        <div class="marquee-content infinite-scroll">
          {marqueeArray.map((s) => (
            <a
              href={s.website}
              target="_blank"
              rel="noopener noreferrer"
              class="sponsor-link"
            >
              <div
                class={`sponsor-tag glass ${s.tier === "escape_velocity" ? "rank-escape" : ""}`}
              >
                <div class="sponsor-brand">
                  <img
                    src={import.meta.env.BASE_URL + s.logo.replace(/^\.\//, "")}
                    alt={s.name}
                    class="sponsor-logo"
                    loading="eager"
                  />
                  <div class="sponsor-info">
                    <span
                      class="rank-label"
                      style={`color: ${TIER_MAP[s.tier]?.color || "#888888"}`}
                    >
                      {TIER_MAP[s.tier]?.label || "PARTNER"}
                    </span>
                    <span class="sponsor-name">{s.name}</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )
  }
</div>
