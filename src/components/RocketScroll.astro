---
import "../styles/rocket.css";
---

<div class="launch-sequence">
  <section class="deep-space">
    <div id="star-field-back" class="star-layer"></div>
    <div id="star-field-front" class="star-layer"></div>

    <div class="rocket-core" id="rocket">
      <div class="rocket-wrapper">
        <img src="/star-rocket.svg" alt="Rocket" class="rocket-svg" />
        <div class="plasma-trail"></div>
      </div>
    </div>

    <div class="titles-container" id="titles">
      <div class="main-logo">
        <img src="/star-text.svg" alt="STAR Logo" />
      </div>
      <p class="subtitle">INTO THE VOID</p>
    </div>
  </section>

  <div class="scroll-spacer"></div>
</div>

<script>
  // Star Field Generator
  function createStars(containerId: string, count: number, size: number) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const shadows: string[] = [];
    for (let i = 0; i < count; i++) {
      const x = Math.floor(Math.random() * 2500);
      const y = Math.floor(Math.random() * 2500);
      shadows.push(`${x}px ${y}px #ffffff`);
    }

    container.style.boxShadow = shadows.join(", ");
    container.style.width = `${size}px`;
    container.style.height = `${size}px`;
  }

  // Initialize Stars on DOM Ready
  document.addEventListener("DOMContentLoaded", () => {
    createStars("star-field-back", 800, 1);
    createStars("star-field-front", 200, 2);
  });

  // Smooth Scroll Parallax Handler
  let ticking = false;

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const s = window.scrollY;
          const rocket = document.getElementById("rocket");
          const titles = document.getElementById("titles");
          const back = document.getElementById("star-field-back");
          const front = document.getElementById("star-field-front");

          // Translate rocket relative to its horizontal center
          if (rocket) {
            rocket.style.transform = `translate3d(-50%, calc(-50% - ${s * 2.5}px), 0)`;
          }

          // Fade and shift titles
          if (titles) {
            const opacity = Math.max(0, 1 - s / 400);
            titles.style.opacity = opacity.toString();
            titles.style.transform = `translate3d(-50%, ${s * 0.15}px, 0)`;
          }

          // Parallax Stars
          if (back) back.style.transform = `translate3d(0, ${s * 0.1}px, 0)`;
          if (front) front.style.transform = `translate3d(0, ${s * 0.25}px, 0)`;

          ticking = false;
        });

        ticking = true;
      }
    },
    { passive: true },
  );
</script>
